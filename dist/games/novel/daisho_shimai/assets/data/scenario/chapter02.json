        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「うん」"
        },
        {
          "type": "dialogue",
          "speaker": "雪乃",
          "text": "「生きてるの？」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「生きてる。怪我もしてない」"
        },
        {
          "type": "dialogue",
          "speaker": "菜緒",
