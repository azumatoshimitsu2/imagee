{
  "chapter": "chapter04",
  "title": "第四章　雪のような嘘",
  "scenes": [
    {
      "id": "s035_return_to_keisuke",
      "number": 35,
      "title": "もう一度、地下へ",
      "background": "bg_kitchen",
      "characters": [],
      "production": {
        "background_label": "白梟館・厨房／午前",
        "bgm_note": "静かな緊張曲",
        "se_note": "冷蔵庫の低い駆動音、遠い風",
        "cast": [
          "真生",
          "菜緒"
        ]
      },
      "events": [
        {
          "type": "narration",
          "text": "三枝さんは、真相を知らなかった。\n水野さんも知らない。\n知っているのは、二十年前に山にいた人間だけだ。"
        },
        {
          "type": "dialogue",
          "speaker": "菜緒",
          "text": "「宗一郎さんに聞く？」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「その前に圭介さん」"
        },
        {
          "type": "dialogue",
          "speaker": "菜緒",
          "text": "「また入るの？」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「うん」"
        },
        {
          "type": "dialogue",
          "speaker": "菜緒",
          "text": "「今度は二分」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「短くなってるじゃん」"
        },
        {
          "type": "dialogue",
          "speaker": "菜緒",
          "text": "「四分十二秒も待たされたから」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「話してたんだから仕方ないだろ」"
        },
        {
          "type": "dialogue",
          "speaker": "菜緒",
          "text": "「じゃあ三分」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「交渉なんだ」"
        },
        {
          "type": "narration",
          "text": "俺は配管の奥を見る。\n圭介さんは、誰が自分を脅したのかを知るために隠れていると言った。\nなら、もう隠れる理由はない。"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「三枝さんだった」"
        },
        {
          "type": "dialogue",
          "speaker": "菜緒",
          "text": "「うん」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「それを伝えてくる」"
        },
        {
          "type": "stage_direction",
          "kind": "演出",
          "text": "真生が小さくなり、配管の隙間へ入る。"
        }
      ],
      "next": "s036_keisuke_and_letter"
    },
    {
      "id": "s036_keisuke_and_letter",
      "number": 36,
      "title": "脅迫状の差出人",
      "background": "bg_cellar",
      "characters": [],
      "production": {
        "background_label": "地下貯蔵室／午前",
        "bgm_note": "わずかに変化。",
        "se_note": "水滴、地下の反響音",
        "cast": [
          "真生",
          "圭介"
        ]
      },
      "events": [
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「また君か」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「三枝さんでした」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「……何が」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「脅迫状」"
        },
        {
          "type": "stage_direction",
          "kind": "間。",
          "text": ""
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「そうか」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「驚かないんですね」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「疑ってはいた」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「でも三枝さん、何も知らなかった」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「何も？」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「お父さんの日記に、圭介さんは悪くないって書いてあった。それだけです」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「……あの人らしい」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「三枝さんのお父さんも、あの山にいたんですよね」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「いた」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「水野さんのお父さんを、見捨てたんですか？」"
        },
        {
          "type": "stage_direction",
          "kind": "間。",
          "text": ""
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「そういうことになっている」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「宗一郎さんと同じ言い方だ」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「……」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「本当は何があったんですか」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「知ってどうする」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「分かりません」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「なら知らない方がいい」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「でも、水野さんは二十年間知らないままです」"
        },
        {
          "type": "stage_direction",
          "kind": "間。",
          "text": ""
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「宗一郎さんも、二十年間黙ったままです」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「……君は面倒な子だな」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「よく言われます」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「嘘だろう」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「今初めて言われました」"
        },
        {
          "type": "stage_direction",
          "kind": "間。",
          "text": ""
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「……戻ろう」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「いいんですか？」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「隠れていた理由はなくなった」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「それに、兄貴もそろそろ逃げるのをやめる頃だ」"
        }
      ],
      "next": "s037_keisuke_returns"
    },
    {
      "id": "s037_keisuke_returns",
      "number": 37,
      "title": "帰ってきた男",
      "background": "bg_kitchen",
      "characters": [],
      "production": {
        "background_label": "白梟館・厨房→食堂／午前",
        "bgm_note": "緊張を保った静かな曲",
        "se_note": "壁際の物音、椅子を引く音",
        "cast": [
          "真生",
          "菜緒",
          "雪乃",
          "宗一郎",
          "冬馬",
          "三枝",
          "遥",
          "圭介"
        ]
      },
      "events": [
        {
          "type": "stage_direction",
          "kind": "演出",
          "text": "圭介はC側から出られないため、菜緒・雪乃が宗一郎へ事情を説明し、厨房の塞がれた旧入口を工具で部分的に解体する。能力は使わない。時間経過を短い暗転で処理。"
        },
        {
          "type": "narration",
          "text": "三十分ほどして、圭介さんは白梟館へ戻った。\n壁を壊したわけではない。\n宗一郎さんが厨房設備の一部を外し、塞がれていた古い扉を人一人が通れるところまで開けた。\n最初からこうすればよかった気もする。\nでも、圭介さんが生きていると分からないうちに、誰も厨房を解体しようとは思わない。"
        },
        {
          "type": "dialogue",
          "speaker": "雪乃",
          "text": "「……叔父さん」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「大きくなったな」"
        },
        {
          "type": "dialogue",
          "speaker": "雪乃",
          "text": "「覚えてるんですか」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「赤ん坊の頃だけな」"
        },
        {
          "type": "dialogue",
          "speaker": "雪乃",
          "text": "「それ、覚えてるって言わないです」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「そうか」"
        },
        {
          "type": "narration",
          "text": "雪乃さんは笑わなかった。\n圭介さんも笑わなかった。\nでも、少しだけ似た顔をしていた。"
        },
        {
          "type": "dialogue",
          "speaker": "三枝",
          "text": "「圭介さん」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「君か」"
        },
        {
          "type": "dialogue",
          "speaker": "三枝",
          "text": "「……すみませんでした」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「何についてだ」"
        },
        {
          "type": "dialogue",
          "speaker": "三枝",
          "text": "「手紙を送ったことです」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「そうか」"
        },
        {
          "type": "dialogue",
          "speaker": "三枝",
          "text": "「それだけですか」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「殴ってほしいのか？」"
        },
        {
          "type": "dialogue",
          "speaker": "三枝",
          "text": "「いえ」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「なら、それでいい」"
        },
        {
          "type": "stage_direction",
          "kind": "間。",
          "text": ""
        },
        {
          "type": "dialogue",
          "speaker": "遥",
          "text": "「圭介さん」"
        },
        {
          "type": "dialogue",
          "speaker": "圭介",
          "text": "「君には、話さないといけないな」"
        },
        {
          "type": "narration",
          "text": "宗一郎さんが目を閉じた。\nそして、ゆっくり開いた。"
        },
        {
          "type": "dialogue",
          "speaker": "宗一郎",
          "text": "「俺が話す」"
        }
      ],
      "next": "s038_twenty_years_truth"
    },
    {
      "id": "s038_twenty_years_truth",
      "number": 38,
      "title": "吹雪の中の四人",
      "background": "bg_past",
      "characters": [],
      "production": {
        "background_label": "二十年前の雪山／回想",
        "bgm_note": "低い弦と風。悲劇を煽りすぎない。",
        "se_note": "風が急激に強くなる。",
        "cast": [
          "若い宗一郎",
          "若い圭介",
          "遥の父",
          "三枝の父"
        ]
      },
      "events": [
        {
          "type": "stage_direction",
          "kind": "演出",
          "text": "回想人物は彩度を落とした立ち絵。現在の宗一郎の語りと回想を交互にする。"
        },
        {
          "type": "narration",
          "text": "「二十年前、俺たち四人は山に入った」"
        },
        {
          "type": "narration",
          "text": "「俺と圭介。水野。そして三枝さんの父親だ」"
        },
        {
          "type": "narration",
          "text": "窓の外では、今も雪が降っていた。\nでも宗一郎さんが話し始めると、もっと古い雪の音が聞こえるような気がした。"
        },
        {
          "type": "stage_direction",
          "kind": "背景切替",
          "text": "山中。雪が強くなり始めている。"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「戻ろう。雲が落ちてきてる」"
        },
        {
          "type": "dialogue",
          "speaker": "若い宗一郎",
          "text": "「この先の避難小屋まで行った方が近い」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「風が変わった。戻った方がいい」"
        },
        {
          "type": "dialogue",
          "speaker": "遥の父",
          "text": "「どうする？」"
        },
        {
          "type": "dialogue",
          "speaker": "三枝の父",
          "text": "「宗一郎。この山はお前が一番知ってる」"
        },
        {
          "type": "stage_direction",
          "kind": "間。",
          "text": ""
        },
        {
          "type": "dialogue",
          "speaker": "若い宗一郎",
          "text": "「進もう」"
        },
        {
          "type": "narration",
          "text": "「判断したのは俺だ」"
        },
        {
          "type": "narration",
          "text": "「天候が崩れることは分かっていた。でも避難小屋までなら行けると思った」"
        },
        {
          "type": "narration",
          "text": "「間違っていた」"
        },
        {
          "type": "stage_direction",
          "kind": "演出",
          "text": "ホワイトアウト。"
        }
      ],
      "next": "s039_accident"
    },
    {
      "id": "s039_accident",
      "number": 39,
      "title": "置いていけ",
      "background": "bg_past",
      "characters": [],
      "production": {
        "background_label": "二十年前の雪山／吹雪",
        "bgm_note": "徐々に弱くなる。",
        "se_note": "足を引きずりながら雪を進む音。",
        "cast": [
          "若い宗一郎",
          "若い圭介",
          "遥の父",
          "三枝の父"
        ]
      },
      "events": [
        {
          "type": "narration",
          "text": "「水野が足を滑らせた」"
        },
        {
          "type": "dialogue",
          "speaker": "遥の父",
          "text": "「ぐっ……！」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「水野！」"
        },
        {
          "type": "dialogue",
          "speaker": "三枝の父",
          "text": "「足が……まずいぞ」"
        },
        {
          "type": "dialogue",
          "speaker": "若い宗一郎",
          "text": "「ここにいろ。俺たちが救助を呼ぶ」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「俺が残る」"
        },
        {
          "type": "dialogue",
          "speaker": "若い宗一郎",
          "text": "「圭介」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「二人で行け。その方が早い」"
        },
        {
          "type": "narration",
          "text": "「俺と三枝さんの父親は、救助を呼びに向かった」"
        },
        {
          "type": "narration",
          "text": "「圭介には、絶対に動くなと言った」"
        },
        {
          "type": "stage_direction",
          "kind": "演出",
          "text": "宗一郎と三枝の父が吹雪へ消える。"
        },
        {
          "type": "dialogue",
          "speaker": "遥の父",
          "text": "「圭介」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「しゃべるな」"
        },
        {
          "type": "dialogue",
          "speaker": "遥の父",
          "text": "「寒いな」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「俺の着ろ」"
        },
        {
          "type": "dialogue",
          "speaker": "遥の父",
          "text": "「お前が凍える」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「俺は動ける」"
        },
        {
          "type": "stage_direction",
          "kind": "演出",
          "text": "圭介が自分の防寒具を水野へ着せる。"
        },
        {
          "type": "narration",
          "text": "「だが、水野の容体が悪くなった」"
        },
        {
          "type": "narration",
          "text": "「圭介は待つのをやめた」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「背負うぞ」"
        },
        {
          "type": "dialogue",
          "speaker": "遥の父",
          "text": "「やめろ」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「黙ってろ」"
        },
        {
          "type": "dialogue",
          "speaker": "遥の父",
          "text": "「お前まで死ぬ」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「死なない」"
        },
        {
          "type": "dialogue",
          "speaker": "遥の父",
          "text": "「置いていけ」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「嫌だ」"
        },
        {
          "type": "dialogue",
          "speaker": "遥の父",
          "text": "「圭介」"
        },
        {
          "type": "dialogue",
          "speaker": "若い圭介",
          "text": "「嫌だって言ってるだろ」"
        },
        {
          "type": "narration",
          "text": "「圭介は、水野を背負って下りた」"
        },
        {
          "type": "narration",
          "text": "「自分の防寒具を着せたまま」"
        },
        {
          "type": "narration",
          "text": "「でも、間に合わなかった」"
        },
        {
          "type": "stage_direction",
          "kind": "演出",
          "text": "白画面へフェード。死亡そのものは直接描写しない。"
        }
      ],
      "next": "s040_the_lie"
    },
    {
      "id": "s040_the_lie",
      "number": 40,
      "title": "誰が決めたのか",
      "background": "bg_dining",
      "characters": [],
      "production": {
        "background_label": "白梟館・食堂／現在",
        "bgm_note": "ほぼ無音。ごく小さなピアノ。",
        "se_note": "風",
        "cast": [
          "真生",
          "菜緒",
          "雪乃",
          "宗一郎",
          "圭介",
          "遥",
          "三枝",
          "冬馬"
        ]
      },
      "events": [
        {
          "type": "dialogue",
          "speaker": "宗一郎",
          "text": "「救助隊が見つけた時、水野はもう死んでいた」"
        },
        {
          "type": "dialogue",
          "speaker": "宗一郎",
          "text": "「圭介も意識がなかった。重度の低体温症だった」"
        },
        {
          "type": "dialogue",
          "speaker": "遥",
          "text": "「……じゃあ」"
        },
        {
          "type": "dialogue",
          "speaker": "宗一郎",
          "text": "「君のお父さんを見捨てたんじゃない」"
        },
        {
          "type": "dialogue",
          "speaker": "遥",
          "text": "「どうして……」"
        },
        {
          "type": "dialogue",
          "speaker": "宗一郎",
          "text": "「すまない」"
        },
        {
          "type": "dialogue",
          "speaker": "遥",
