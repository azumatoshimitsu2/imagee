          "type": "dialogue",
          "speaker": "菜緒",
          "style": "菜緒",
          "text": "「全部隠してくれるじゃん」"
        },
        {
          "type": "directive",
          "kind": "演出",
          "text": "窓の外。雪に覆われた道路と山。"
