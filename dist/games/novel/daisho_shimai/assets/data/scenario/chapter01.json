          "text": "「知ってたんですか？」"
        },
        {
          "type": "stage_direction",
          "kind": "間。",
          "text": ""
        },
        {
          "type": "dialogue",
          "speaker": "宗一郎",
          "text": "「昔の話だ」"
        },
        {
          "type": "dialogue",
          "speaker": "雪乃",
          "text": "「お父さん、これ何？」"
        },
        {
          "type": "dialogue",
          "speaker": "宗一郎",
          "text": "「昔、荷物を運んでいた索道だ。道路ができる前にな」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「向こうの雪原まで？」"
        },
        {
          "type": "dialogue",
          "speaker": "宗一郎",
          "text": "「……そうだ」"
        },
        {
          "type": "narration",
          "text": "返事が少し遅れた。"
        },
        {
          "type": "dialogue",
          "speaker": "菜緒",
          "text": "「じゃあ、榊原さんはこれで――」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「足跡の始まるところまで行った」"
        },
        {
          "type": "dialogue",
          "speaker": "雪乃",
          "text": "「そんな……」"
        },
        {
          "type": "dialogue",
          "speaker": "宗一郎",
          "text": "「危険すぎる。今は人を乗せる設備じゃない」"
        },
        {
          "type": "dialogue",
          "speaker": "真生",
          "text": "「でも使った人がいる」"
